{
  "name": "@freecollab/mobile",
  "version": "0.13.0",
  "private": true,
  "description": "Customer-owned FreeCollab Android and iOS clients",
  "author": "Kris Ledel",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "sync": "node scripts/configure.mjs && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "test": "node --test tests/*.test.mjs",
    "build:android": "node scripts/configure.mjs && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  },
  "overrides": {
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  }
}
