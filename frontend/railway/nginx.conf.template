# Railway terminates public HTTPS. Only this service has a public domain.
# Raw request URLs may contain Office capabilities/OAuth codes: no request logs.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
geo $realip_remote_addr $trusted_edge_peer { default 0; ${FREECOLLAB_TRUSTED_EDGE_CIDR} 1; }
map "$trusted_edge_peer:$http_x_forwarded_proto" $upstream_scheme { default $scheme; "1:https" https; }
upstream freecollab_private_api { server ${FREECOLLAB_BACKEND_HOST}:8000; }

# Railway readiness may use its own Host. Permit only this generic endpoint
# outside the application's exact configured host; never serve the app/API.
server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;
    access_log off;
    error_log /dev/null emerg;
    location = /api/ready {
        proxy_pass http://freecollab_private_api/ready;
        proxy_set_header Host ${FREECOLLAB_PUBLIC_HOST};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
    location / { return 421; }
}
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name ${FREECOLLAB_PUBLIC_HOST};
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 51m;
    access_log off;
    error_log /dev/null emerg;
    set_real_ip_from ${FREECOLLAB_TRUSTED_EDGE_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location ^~ /api/office-edit/ {
        proxy_pass http://freecollab_private_api/office-edit/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        add_header Cache-Control "private, no-store" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /.well-known/apple-app-site-association {
        proxy_pass http://freecollab_private_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /.well-known/assetlinks.json {
        proxy_pass http://freecollab_private_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /open {
        proxy_pass http://freecollab_private_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header X-Content-Type-Options nosniff always;
    }
    location /api/ {
        proxy_pass http://freecollab_private_api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location /socket.io/ {
        proxy_pass http://freecollab_private_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_scheme;
        proxy_read_timeout 75s;
    }
    location ~ ^/embed-entry\.(js|css)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /service-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /manifest.webmanifest {
        types { application/manifest+json webmanifest; }
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~* \.mjs$ { types { application/javascript mjs; } try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
}
