# The operator's certificate must cover app + Matrix DNS names. Never expose
# private Synapse admin/registration/client routes on the federation listener.
map $http_upgrade $federation_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name ${FREECOLLAB_PUBLIC_HOST};
    ssl_certificate /etc/freecollab/tls/server.crt;
    ssl_certificate_key /etc/freecollab/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    # OAuth codes/state and office/guest capabilities can occur in request URLs.
    # The outer edge must suppress them even when the inner frontend also does.
    access_log off;
    error_log /dev/null emerg;
    client_max_body_size 51m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location ^~ /connect/federation/wire/ {
        access_log off;
        error_log /dev/null emerg;
        client_max_body_size 128k;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        add_header Cache-Control "private, no-store" always;
    }
    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $federation_connection_upgrade;
        proxy_read_timeout 75s;
    }
}
server {
    listen 8448 ssl;
    server_name ${MATRIX_SERVER_NAME};
    ssl_certificate /etc/freecollab/tls/server.crt;
    ssl_certificate_key /etc/freecollab/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 51m;
    access_log off;
    error_log /dev/null emerg;
    location ^~ /_matrix/federation/ {
        proxy_pass http://matrix:8008;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
    location ^~ /_matrix/key/ {
        proxy_pass http://matrix:8008;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
