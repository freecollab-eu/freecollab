DATABASE_URL=sqlite:///./freecollab.db
JWT_SECRET=change-me-in-production
STORAGE_PATH=./data/files
STORAGE_BACKEND=local
# Optional customer-owned S3-compatible file storage. See docs/OBJECT_STORAGE.md.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_KEY_PREFIX=freecollab/
S3_CA_BUNDLE=
S3_ALLOW_INSECURE_HTTP=false
# Optional customer-owned Valkey/Redis coordination; rediss:// for remote TLS.
REDIS_URL=
REDIS_NAMESPACE=freecollab
REDIS_TLS_REQUIRED=true
REDIS_PRESENCE_LEASE_SECONDS=75
ENTERPRISE_SEARCH_ENABLED=true
# Optional customer-owned Vault Transit key custody. No message plaintext is sent.
ENTERPRISE_VAULT_URL=
ENTERPRISE_VAULT_TOKEN=
ENTERPRISE_VAULT_MOUNT=transit
ENTERPRISE_VAULT_KEY=freecollab
ENTERPRISE_VAULT_NAMESPACE=
# Optional larger meetings. Start the large-meetings Compose profile too.
MEETINGS_SFU_PROVIDER=disabled
MEETINGS_SFU_URL=
MEETINGS_SFU_API_URL=
MEETINGS_SFU_API_KEY=
MEETINGS_SFU_API_SECRET=
MEETINGS_SFU_MAX_PARTICIPANTS=100
# Optional verified same-origin Whisper weights prepared before the frontend build.
VITE_WHISPER_MODEL_BASE_PATH=
ENVIRONMENT=development
# Local development only. The first API startup creates a private durable
# ./data/message-keys.json content key, independent of JWT_SECRET.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# For the Docker pilot, run python scripts/pilot-init.py from the repo root.
# It writes a private pilot.env with independent random signing/content keys.
# Before public exposure, set ENVIRONMENT=production, a private JWT_SECRET,
# explicit HTTPS CORS_ORIGINS and a base64 32-byte content-key ring:
# MESSAGE_ENCRYPTION_KEYS={"key-1":"<base64-encoded-32-byte-random-key>"}
# MESSAGE_ENCRYPTION_ACTIVE_KEY_ID=key-1
# Retain older key IDs until migration/backup recovery has been verified.
# LEGACY_MESSAGE_ENCRYPTION_KEY is only for explicitly retained pre-0.4 keys.

# Account factors and queued recovery emails use a third, independent random
# standard-base64 32-byte key. Do not reuse JWT or message-encryption keys.
# In local development only, an omitted key is generated once in a private file.
# ACCOUNT_SECURITY_KEY=<base64-encoded-32-byte-random-key>
ACCOUNT_SECURITY_KEY_FILE=./data/account-security.key
# Before provider registration, set the deployment's public HTTPS origin.
# Integrations -> Connection setup generates exact callbacks and permission
# checklists from this origin; see docs/CONNECTION_SETUP.md.
PUBLIC_APP_URL=http://127.0.0.1:3000

# Local file delivery is private and development-only. Queueing does not send:
# run `python -m app.services.mail` from backend to deliver committed emails.
# Production: use disabled until SMTP is configured, then select smtp and run
# the worker. File delivery is refused in production.
MAIL_DELIVERY_MODE=file
MAIL_FILE_PATH=./data/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FreeCollab <no-reply@localhost>
SMTP_STARTTLS=true
SMTP_IMPLICIT_TLS=false
SMTP_TIMEOUT=15

# End-to-end encrypted channels require the private Matrix service and browser
# device-key setup. Enable explicitly only after starting Compose profile secure.
MATRIX_ENABLED=false
MATRIX_SERVER_NAME=freecollab.local
# MATRIX_REGISTRATION_SHARED_SECRET=<independent-random-secret>
MATRIX_INTERNAL_URL=http://matrix:8008

# Optional bilateral channels between independent customer installations.
# Retain database/native keys; exchange public installation keys out of band.
# See docs/CONNECT_FEDERATION.md and deploy/federation/compose.example.yml.
CONNECT_FEDERATION_ENABLED=false
CONNECT_FEDERATION_PUBLIC_URL=
CONNECT_FEDERATION_PEERS={}
MATRIX_FEDERATION_DOMAINS=[]

ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_DEMO_AI=false
# Deprecated and ignored: anonymous server demo routes have been removed.

# Customer workspace SSO is configured by each workspace owner/admin under
# Integrations -> Sign-in. It needs PUBLIC_APP_URL (HTTPS) + ACCOUNT_SECURITY_KEY,
# and works with OIDC_ENABLED=false. Customer credentials are encrypted per
# workspace; existing verified members explicitly link after password/MFA.
# Save disabled draft -> test -> enable; share that workspace's opaque login link.
# See docs/OIDC.md. Do not put customer provider credentials in these env keys.
#
# Legacy operator-managed global OIDC provider compatibility only. Keep disabled
# unless deliberately retaining that earlier installation-wide login behavior.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Organization SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Legacy operator provider only: explicit trust in that issuer's email assurance.
# This never allows customer workspace provisioning or automatic email linking.
OIDC_TRUST_EMAIL_CLAIM=false

# Explicit channel grants; delivery bodies contain generic IDs, never E2EE text.
WEBHOOKS_ENABLED=false
# Optional version timestamp requests; each request requires a deliberate user
# action. Only a digest is shared, but digests can correlate known content.
OTRUST_ENABLED=false
OTRUST_BASE_URL=https://www.otrust.eu
OTRUST_TIMEOUT_SECONDS=10
# Optional independent read-only credential for /operations/metrics only.
# Generate at least 32 random bytes and keep the value in private operator config.
OPERATIONS_METRICS_TOKEN=
# Retain authenticated security-action metadata for 7–365 days; no content or credentials.
SECURITY_AUDIT_RETENTION_DAYS=90
SECURITY_AUDIT_MAX_RECORDS=100000
# Run Compose profile integrations (and mail for email delivery) when enabled.

# Native-channel two-way document/calendar sync. Each customer configures its
# own OAuth application or DAV app-password in Integrations -> Sync. Secrets
# are stored encrypted; start the integrations worker after enabling.
# Secure channels never fall back to server-side plaintext sync.
SYNC_ENABLED=false


# Local durable product jobs share the integrations worker. Start it with
# `docker compose --profile integrations up -d` for workflows and data exports.
# Retention remains disabled and on hold until an owner explicitly configures it.
WORKFLOWS_ENABLED=true
DATA_CONTROLS_ENABLED=true
ACTIVITY_FEEDS_ENABLED=true
# Customer-owned providers are configured in the workspace after operator opt-in.
CLOUD_FILES_ENABLED=false
EXTERNAL_MEETINGS_ENABLED=false
COPILOT_ENABLED=false

# Optional generic Web Push. Generate an independent EC VAPID key with
# scripts/push-keygen.py, then store the PEM privately (quoted multiline env).
# A browser must explicitly enable notifications and confirm endpoint ownership.
PUSH_ENABLED=false
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Optional customer-owned native Android/iOS alerts. See docs/NATIVE_PUSH.md.
# Service-account JSON and multiline APNs PEM belong in a private secret store.
NATIVE_PUSH_ENABLED=false
NATIVE_CALLS_ENABLED=false
NATIVE_PUSH_FCM_PROJECT_ID=
NATIVE_PUSH_FCM_SERVICE_ACCOUNT=
NATIVE_PUSH_APNS_TEAM_ID=
NATIVE_PUSH_APNS_KEY_ID=
NATIVE_PUSH_APNS_TOPIC=eu.freecollab.mobile
NATIVE_PUSH_APNS_PRIVATE_KEY=
NATIVE_PUSH_APNS_SANDBOX=false

# WebRTC has no external ICE servers by default. For Internet/NAT meetings,
# configure your own STUN/TURN deployment. TURN credentials are short-lived.
MEETINGS_ICE_SERVERS=[]
MEETINGS_TURN_URLS=[]
MEETINGS_TURN_SECRET=
