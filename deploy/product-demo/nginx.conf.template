worker_processes 1;
pid /tmp/freecollab-demo-nginx.pid;
error_log /dev/null crit;
events { worker_connections 512; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  client_body_temp_path /tmp/freecollab-demo-body;
  proxy_temp_path /tmp/freecollab-demo-proxy;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen ${PORT};
    server_name _;
    root /srv;
    client_max_body_size 2m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ${WEBSOCKET_ORIGIN}; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors ${WEBSITE_ORIGIN}" always;
    location = / { return 302 /product-demo/; }
    location = /product-demo { return 302 /product-demo/; }
    location = /healthz { proxy_pass http://127.0.0.1:8000/ready; }
    location = /service-worker.js { return 404; }
    location = /product-demo/service-worker.js { return 404; }
    location /api/ {
      proxy_pass http://127.0.0.1:8000/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
    location /socket.io/ {
      proxy_pass http://127.0.0.1:8000;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_read_timeout 75s;
    }
    location /product-demo/ {
      try_files $uri $uri/ /product-demo/index.html;
    }
    location / { return 404; }
  }
}
